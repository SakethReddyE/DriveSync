# DriveSync frontend — environment variables (Vite exposes only VITE_* to the client)
# Copy to `.env` for local dev. Set these in the Vercel project settings for production.

# Backend REST API base URL
VITE_API_URL=http://localhost:5000/api

# Backend Socket.io URL (usually the API host without /api)
VITE_SOCKET_URL=http://localhost:5000

# Google OAuth 2.0 Web Client ID (added in the auth phase)
VITE_GOOGLE_CLIENT_ID=
