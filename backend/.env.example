# ──────────────────────────────────────────────────────────────
# DriveSync backend — environment variables
# Copy this file to `.env` for local dev. In production, set these in the
# Render dashboard (Environment tab). The real `.env` is gitignored — never commit it.
# ──────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas M0 free tier).
# Atlas → Database → Connect → Drivers → copy the SRV string, then add the db name (drivesync).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/drivesync?retryWrites=true&w=majority

# JWT signing secret — use a long random string:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin login (the unified /api/auth/login checks these directly).
ADMIN_EMAIL=admin@drivesync.in
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Frontend origin allowed by Socket.io CORS. Local dev = Vite's port. Prod = your Vercel URL.
CLIENT_ORIGIN=http://localhost:5173

# Local server port.
PORT=5000

# Google Sign-In (added in the auth phase) — OAuth 2.0 Web Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=
